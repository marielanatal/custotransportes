# Copie para .env e ajuste. O .env não vai para o repositório.
#
#   cp .env.example .env
#
# Este banco é local e roda só dataset sintético. Ainda assim, senha aqui é
# senha: não reuse nenhuma que você use em outro lugar.

POSTGRES_DB=custotransportes
POSTGRES_USER=custo
POSTGRES_PASSWORD=troque_esta_senha

# Porta no host. 5433 evita colisão com um Postgres instalado na máquina.
POSTGRES_PORT=5433
