# Normaliza fim de linha. Você desenvolve no Windows, o Postgres roda em
# container Linux: arquivo .sql ou script de shell com CRLF quebra lá dentro,
# e o erro que aparece não tem nada a ver com a causa.
#
# Regra: LF no repositório e no disco, salvo onde o Windows exige CRLF.

* text=auto eol=lf

*.sql  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh   text eol=lf

# Scripts nativos do Windows precisam de CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binários: nunca converter
*.png  binary
*.jpg  binary
*.pdf  binary
*.xlsx binary
